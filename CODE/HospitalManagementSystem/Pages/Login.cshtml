@page
@model HospitalManagementSystem.Pages.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reserve Health - Login</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7f9;
            color: #17384d;
        }

        .page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .card {
            width: 100%;
            max-width: 430px;
            background: white;
            padding: 40px;
            border-radius: 16px;
            border: 1px solid #d7e2e8;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
        }

        .brand {
            text-align: center;
            margin-bottom: 28px;
        }

        .brand h1 {
            margin: 0;
            color: #0a4568;
            font-size: 30px;
        }

        .brand p {
            margin-top: 7px;
            color: #687b86;
        }

        h2 {
            text-align: center;
            margin-bottom: 25px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            margin-top: 16px;
            font-weight: 600;
        }

        input {
            width: 100%;
            padding: 12px;
            border: 1px solid #b8c8d1;
            border-radius: 8px;
            font-size: 15px;
        }

        input:focus {
            outline: none;
            border-color: #1682ad;
        }

        button {
            width: 100%;
            margin-top: 24px;
            padding: 13px;
            background: #126785;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
        }

        button:hover {
            background: #0d536c;
        }

        .account-link {
            text-align: center;
            margin-top: 22px;
            color: #667985;
        }

        .account-link a {
            color: #126785;
            font-weight: 600;
            text-decoration: none;
        }

        .account-link a:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <div class="page">
        <div class="card">

            <div class="brand">
                <h1>Reserve Health</h1>
                <p>Clinical management portal</p>
            </div>

            <h2>Login</h2>

            <form method="post">

                <label for="email">Email</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="Enter your email"
                    required />

                <label for="password">Password</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Enter your password"
                    required />

                <button type="submit">
                    Login
                </button>

            </form>

            <p class="account-link">
                Don't have an account?
                <a href="/Signup">Sign up</a>
            </p>

        </div>
    </div>
</body>
</html>